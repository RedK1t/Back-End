# RedKit orchestrator configuration

# Control API port (create/stop/heartbeat/status)
PORT=3008

# Authenticated data-gateway port (the only way to reach a container)
GATEWAY_PORT=3009

# Stop a user's container after this many ms with no heartbeat (default 5 min)
IDLE_TIMEOUT_MS=300000

# Lifetime of a gateway ticket/cookie (default 6h) — long enough to cover a session
TICKET_TTL_MS=21600000

# Secret used to HMAC-sign gateway tickets/cookies. MUST be a long random value.
GATEWAY_SECRET=change-me-to-a-long-random-string

# Private Docker network the per-user containers join; the gateway reaches them by IP.
DOCKER_NETWORK=redkit-net

# Hostname the front-end uses to reach the gateway.
# "localhost" for local dev; a public hostname/IP in deployment (see DEPLOYMENT.md).
PUBLIC_HOST=localhost

# Image used for each per-user browser container (built from ./Docker)
KALI_IMAGE=kalinew:latest

# Container-internal ports the gateway targets (NOT published to the host)
VNC_CONTAINER_PORT=6080
PROXY_CONTAINER_PORT=5050

# Supabase project — used ONLY to verify the user's access token (no secrets needed)
SUPABASE_URL=https://zxcmlsafspvebelqymhe.supabase.co
SUPABASE_ANON_KEY=sb_publishable_KjuqzhXNxFvR61SzqniM9Q_tPaHSlKC
